{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "to-decide",
	"compatibility_date": "2026-08-20",
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Caps how often one IP can reach the LLM-backed routes. Every call there
	// spends the project's Gemini quota, so the limit is deliberately low.
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 20, "period": 60 }
			}
		]
	}
}
